# ---------- both services ----------
SOURCE=google                    # "google" (real sheet) or "csv" (sample files in sample/data)
SHEET_ID=                        # the id in the Google Sheet URL: /spreadsheets/d/<SHEET_ID>/edit
GOOGLE_CREDENTIALS=              # the service-account JSON key (paste the JSON, or its base64)
EVENT_YEAR=2026                  # used when a date has no year, e.g. "21 Oct"
ADMIN_KEY=                       # long random string; part of the private host URL

# ---------- public service ----------
SLOT_TAB=Roster                  # tab with student_id, name, category, state, R1 date, R1 slot, ... (or Master_Schedule)
SHOW_STATE=false                 # true = also show each student's state on the public page
DATA_DIR=/var/data               # Render persistent disk; keeps the two host switches across restarts
DEFAULT_ROSTER_VISIBLE=false     # used only the first time: the Roster tab (all students, 3 rounds) starts hidden
DEFAULT_SLOTS_VISIBLE=false      # used only the first time (before a switch is saved)
DEFAULT_PAIRINGS_VISIBLE=true
AUTO_REFRESH_SECONDS=300         # every 5 minutes (default); 0 = manual refresh only

# ---------- adjudicator service ----------
ADJ_SECRET=                      # long random string; changing it invalidates every personal link
BALLOT_APP_URL=                  # the ballot web-app URL (leave empty until you have it)
CACHE_SECONDS=15                 # how long sheet reads are reused
BASE_URL=                        # optional: public https URL of this service, used in the links page
